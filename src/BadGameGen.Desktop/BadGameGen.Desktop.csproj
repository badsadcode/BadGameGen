<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project compile on Linux/macOS CI; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>BadGameGen</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Don't ship the WebView2 XML API docs next to the exe. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BadGameGen.App\BadGameGen.App.csproj" />
  </ItemGroup>
  <!-- Normal builds: content and frontend sit next to the exe as loose files. -->
  <ItemGroup Condition="'$(PublishSingleFile)' != 'true'">
    <None Include="..\..\content\**\*.json" Link="content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\frontend\dist\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Single-file builds: embed everything; BundledContent unpacks it on first run. -->
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EmbeddedResource Include="..\..\content\**\*.json" LogicalName="bundle/content/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\frontend\dist\**\*" LogicalName="bundle/wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
